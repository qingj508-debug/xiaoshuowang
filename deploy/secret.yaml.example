# ============================================================
# 这是模板文件，不要直接使用！
# 使用步骤见 README 或下方注释
# ============================================================
# 1. cp secret.yaml.example secret.yaml
# 2. 将占位符替换为真实值
# 3. kubeseal --controller-name=sealed-secrets -o yaml < secret.yaml > sealed-secret.yaml
# 4. rm secret.yaml （不要提交明文！）
# 5. git add sealed-secret.yaml && git commit
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: endpoint-secrets
  namespace: endpoint
type: Opaque
stringData:
  # ===== Nacos =====
  NACOS_SERVER_ADDR: "nacos-service:8848"

  # ===== MySQL =====
  MYSQL_HOST: "192.168.10.109"
  MYSQL_PORT: "3306"
  MYSQL_USERNAME: "root"
  MYSQL_PASSWORD: "your_mysql_password"

  # ===== Redis =====
  REDIS_HOST: "redis-service"
  REDIS_PORT: "6379"
  REDIS_PASSWORD: ""

  # ===== RabbitMQ =====
  RABBITMQ_HOST: "rabbitmq-service"
  RABBITMQ_PORT: "5672"
  RABBITMQ_VIRTUAL_HOST: "/"

  # ===== Elasticsearch =====
  ELASTICSEARCH_HOST: "elasticsearch-service"
  ELASTICSEARCH_PORT: "9200"
  ELASTICSEARCH_SCHEME: "http"

  # ===== Alibaba Cloud OSS =====
  ALIYUN_OSS_BUCKET_NAME: "endpoint-oss1"
  ALIYUN_OSS_ACCESS_KEY_ID: "your_aliyun_access_key_id"
  ALIYUN_OSS_ACCESS_KEY_SECRET: "your_aliyun_access_key_secret"

  # ===== Alipay =====
  ALIPAY_APP_ID: "your_alipay_app_id"
  ALIPAY_MERCHANT_PRIVATE_KEY: "your_alipay_merchant_private_key"
  ALIPAY_PUBLIC_KEY: "your_alipay_public_key"

  # ===== Tencent Cloud SMS =====
  TENCENT_CLOUD_SECRET_ID: "your_tencent_secret_id"
  TENCENT_CLOUD_SECRET_KEY: "your_tencent_secret_key"
