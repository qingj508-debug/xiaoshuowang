# ============================================================
# 模板：只存敏感密钥，非敏感配置请写在 deploy/configmap.yaml
# ============================================================
# 使用步骤：
# 1. cp secret.yaml.example secret.yaml → 填真实值
# 2. kubeseal --controller-name=sealed-secrets -o yaml < secret.yaml > sealed-secret.yaml
# 3. rm secret.yaml ; git add sealed-secret.yaml ; git commit
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: endpoint-secrets
  namespace: endpoint
type: Opaque
stringData:
  # ===== MySQL =====
  MYSQL_PASSWORD: "your_mysql_password"

  # ===== Redis =====
  REDIS_PASSWORD: "your_redis_password"

  # ===== Alibaba Cloud OSS =====
  ALIYUN_OSS_ACCESS_KEY_ID: "your_access_key_id"
  ALIYUN_OSS_ACCESS_KEY_SECRET: "your_access_key_secret"

  # ===== Alipay =====
  ALIPAY_APP_ID: "your_app_id"
  ALIPAY_MERCHANT_PRIVATE_KEY: "your_merchant_private_key"
  ALIPAY_PUBLIC_KEY: "your_alipay_public_key"

  # ===== Tencent Cloud SMS =====
  TENCENT_CLOUD_SECRET_ID: "your_secret_id"
  TENCENT_CLOUD_SECRET_KEY: "your_secret_key"
